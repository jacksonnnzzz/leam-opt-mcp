# Provider routing. DeepSeek is text-only; keep a multimodal provider for attachments.
ANTENNA_TEXT_PROVIDER=deepseek
ANTENNA_VISION_PROVIDER=ollama

# DeepSeek reasoning/code generation configuration
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# OpenAI multimodal configuration for image/PDF source analysis
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_VISION_MODEL=gpt-5.6-sol
OPENAI_IMAGE_DETAIL=original

# Local image/PDF analysis (no cloud vision key required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=qwen3-vl:8b
OLLAMA_NUM_CTX=16384
OLLAMA_PDF_DPI=144
OLLAMA_PDF_MAX_PAGES=40
OLLAMA_PDF_TEXT_MAX_CHARS=120000
OLLAMA_TIMEOUT_SECONDS=900

# Server workspace and optional AEDT override. Leave the executable empty to use
# ANSYSEM_ROOTxxx or normal installation discovery.
ANTENNA_MCP_WORKSPACE=.antenna-mcp
ANTENNA_MCP_AEDT_EXECUTABLE=
ANTENNA_MCP_GRPC_MODE=auto
ANTENNA_MCP_TRANSPORT=stdio

# Keep disabled until generated artifacts and simulation settings are reviewed.
ANTENNA_MCP_ALLOW_SIMULATION=0
